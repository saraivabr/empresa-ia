# Empresa.ia — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to git. It is listed in .gitignore.

# ============================================================
# === UAZAPI — WhatsApp gateway                            ===
# ============================================================

# Your uazapi subdomain (e.g. mycompany.uazapi.com)
UAZ_SERVER=https://YOUR_SUBDOMAIN.uazapi.com

# Instance token (from uazapi dashboard → instance → token)
UAZ_TOKEN=your-uazapi-instance-token

# Admin token (from uazapi dashboard → admin settings)
UAZ_ADMIN_TOKEN=your-uazapi-admin-token

# ============================================================
# === BRIDGE — core bridge settings                        ===
# ============================================================

# Absolute path to instances.json (copy from instances.json.example)
INSTANCES_FILE=/opt/empresa-ia/instances.json

# Path to the openclaw binary (AI agent brain)
OPENCLAW_BIN=/usr/bin/openclaw

# Comma-separated owner WhatsApp numbers (digits only, no + or spaces)
# These numbers get elevated access. Set to your own number.
OWNER_NUMBERS=55119XXXXXXXX

# Webhook secret — appended to the webhook path: POST /hook/<WEBHOOK_SECRET>
# Generate with: openssl rand -hex 20
WEBHOOK_SECRET=

# Public URL base for media assets (trailing slash required)
# Point this to wherever you serve the public/ folder
ASSET_BASE=https://your-domain.com/assets/

# Absolute path to the local public assets folder
PUBLIC_DIR=/opt/empresa-ia/public

# Health check server port and bind address
HEALTH_PORT=8090
BIND_HOST=127.0.0.1

# Agent session timeout in seconds
AGENT_TIMEOUT_SEC=180

# Debounce window to batch rapid messages from the same chat (ms)
DEBOUNCE_MS=1500

# How long before showing "thinking…" indicator (ms). 0 = off.
THINK_DELAY_MS=3500

# Session keep-warm interval (ms). 0 = off. Reduces cold-start latency.
PREWARM_MS=240000

# Enable SSE fallback alongside webhook (0 = off)
ENABLE_SSE=1

# ============================================================
# === AI PROVIDERS                                         ===
# ============================================================

# Groq — primary audio transcription (Whisper)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google / Gemini — audio transcription fallback, image/video description, TTS
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for transcription and vision tasks
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# Enable audio transcription (set to 0 to disable)
ENABLE_AUDIO_TRANSCRIPTION=1

# ============================================================
# === LIVEKIT — voice call infrastructure                  ===
# ============================================================
# Generate keys with: lk generate-key
# https://cloud.livekit.io or self-hosted

LIVEKIT_URL=wss://your-livekit-host:7880
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Gemini live audio model for voice agent
# Options: gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Enable affective dialog (expressive tone) — 1 or 0
VOZ_AFFECTIVE=1

# Enable agent proactivity (agent pulls conversation) — 1 or 0
VOZ_PROACTIVITY=0

# ============================================================
# === SIP TRUNK — outbound calls                          ===
# ============================================================
# LiveKit SIP trunk ID for outbound calls
# Create in LiveKit Cloud console → SIP → Trunks
VOZ_SIP_TRUNK=ST_your_sip_trunk_id_here

# Voice call mode: livekit (default) or autocalls
VOZ_CALL_MODE=livekit

# LiveKit CLI binary path (used to create rooms and dispatch calls)
LK_BIN=/usr/local/bin/lk

# ============================================================
# === WAVOIP — alternative voice call provider (optional) ===
# ============================================================
# Leave blank to use LiveKit instead

WAVOIP_BASE_URL=
WAVOIP_API_KEY=
WAVOIP_DEVICE_TOKEN=
WAVOIP_CALL_ENDPOINT=/calls/whatsapp
WAVOIP_DEVICE_URL=https://devices.wavoip.com
WAVOIP_TIMEOUT_MS=30000

# ============================================================
# === AUTOCALLS — alternative AI call provider (optional) ===
# ============================================================
# Leave blank to use LiveKit instead

AUTOCALLS_BASE_URL=
AUTOCALLS_API_KEY=
AUTOCALLS_ASSISTANT_ID=

# ============================================================
# === COMPOSIO — tool integrations (Gmail, Calendar, etc) ===
# ============================================================
# https://app.composio.dev → API Keys
COMPOSIO_API_KEY=your_composio_api_key_here

# Your Composio user ID (identifies the connected accounts)
COMPOSIO_USER_ID=your-user-id

# ============================================================
# === DATA FILES                                           ===
# ============================================================

EMPRESAIA_USAGE_FILE=/opt/empresa-ia/empresaia-usage.json
LEADS_FILE=/opt/empresa-ia/leads.json
GROUP_EMP_FILE=/opt/empresa-ia/group-emps.json

# ============================================================
# === VOZ-BRIDGE (ElevenLabs bridge — optional)           ===
# ============================================================
# Only needed if you use voz-bridge.py with ElevenLabs

UAZAPI_URL=https://YOUR_SUBDOMAIN.uazapi.com
UAZAPI_TOKEN=your-uazapi-instance-token

EL_INIT_WEBHOOK_SECRET=generate-random-secret
EL_POSTCALL_WEBHOOK_SECRET=generate-random-secret
BRIDGE_TOOL_BEARER=generate-random-bearer-token
BRIDGE_INIT_SECRET=generate-random-secret
EL_VERIFY_SIGNATURES=1
BRIDGE_PORT=8077
BRIDGE_BIND=127.0.0.1
